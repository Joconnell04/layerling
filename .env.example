# Copy is written by scripts/secrets.sh. Never commit .env.
MESHY_API_KEY=
MESHY_TEST_API_KEY=
MESHY_MODE=test            # test | live
MESHY_WEBHOOK_TOKEN=       # random string; the Meshy webhook URL carries it as ?token=
CLAUDE_BACKEND=claude_code   # claude_code (OAuth, default) | api (turnkey, explicit only)
ANTHROPIC_API_KEY_TURNKEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RUNPOD_API_KEY=
RUNPOD_SAM3_ENDPOINT_ID=
SAM3_BACKEND=mock          # mock | local | runpod | off
SAM3_LOCAL_PATH=            # folder with SAM 3 weights (transformers format), default ~/models/sam3
HF_TOKEN=
SLICER_BIN=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio
BUILD_SPEND_CEILING_USD=150
JOB_CAP_USD=10
JOB_CAP_CREDITS=400
ACCESS_CODE=                # studio access code (server only)
ACCESS_COOKIE_SECRET=
ORDER_NOTIFY_EMAIL=
AGENTMAIL_API_KEY=          # order emails; orders are stored either way
AGENTMAIL_INBOX_ID=         # sending inbox
