{
  "$defs": {
    "AddOn": {
      "additionalProperties": false,
      "description": "Exact geometry added in s06. Generated, never asked of Meshy (AI meshes garble text).",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AddOnKind"
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "filament_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filament Id"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "description": "e.g. loop_inner_d_mm, plate_w_mm, plate_d_mm, plate_t_mm, pocket_d_mm, pocket_depth_mm, position (top|back|left|right)",
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AddOn",
      "type": "object"
    },
    "AddOnKind": {
      "enum": [
        "round_base",
        "oval_base",
        "keyring_loop",
        "hanging_loop",
        "nameplate",
        "flat_back",
        "magnet_pocket"
      ],
      "title": "AddOnKind",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "cap_usd": {
          "default": 10.0,
          "title": "Cap Usd",
          "type": "number"
        },
        "cap_credits": {
          "default": 400,
          "title": "Cap Credits",
          "type": "integer"
        },
        "spent_usd": {
          "default": 0.0,
          "title": "Spent Usd",
          "type": "number"
        },
        "spent_credits": {
          "default": 0,
          "title": "Spent Credits",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "CustomAsk": {
      "additionalProperties": false,
      "description": "Something the customer asked to see beyond the subjects themselves: a prop, an outfit, a\npose, a name. Carried from intake into the concept prompt, the concept check and the views,\nso it survives into the 3D model.",
      "properties": {
        "kind": {
          "enum": [
            "prop",
            "outfit",
            "pose",
            "expression",
            "text",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "description": "In the customer's words, e.g. wearing a sombrero",
          "maxLength": 120,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "s1, s2, ... or None for the whole piece",
          "title": "Subject Id"
        },
        "source": {
          "default": "request",
          "enum": [
            "request",
            "answer",
            "form"
          ],
          "title": "Source",
          "type": "string"
        },
        "buildable": {
          "default": true,
          "description": "False when the product has nowhere to put it (a name on a 3D keychain); never drawn or checked, and the customer gets a note",
          "title": "Buildable",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "CustomAsk",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "draft",
        "queued",
        "running",
        "waiting_user",
        "paused",
        "review",
        "done",
        "failed",
        "cancelled"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "Photo": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "input/photo_<n>.<ext>",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "subject_ids": {
          "description": "Filled by intake",
          "items": {
            "type": "string"
          },
          "title": "Subject Ids",
          "type": "array"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "Photo",
      "type": "object"
    },
    "PrintSettings": {
      "additionalProperties": false,
      "properties": {
        "printer": {
          "default": "Bambu Lab X2D",
          "title": "Printer",
          "type": "string"
        },
        "nozzle_mm": {
          "default": 0.4,
          "title": "Nozzle Mm",
          "type": "number"
        },
        "layer_mm": {
          "default": 0.2,
          "title": "Layer Mm",
          "type": "number"
        },
        "ams_slots": {
          "default": 5,
          "description": "FROM JACKSON: 5 loaded AMS slots",
          "maximum": 16,
          "minimum": 1,
          "title": "Ams Slots",
          "type": "integer"
        },
        "slicer": {
          "default": "bambu_studio",
          "enum": [
            "bambu_studio",
            "orcaslicer",
            "p2p_slicer"
          ],
          "title": "Slicer",
          "type": "string"
        },
        "process_overrides": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Slicer process keys, e.g. enable_support=1",
          "title": "Process Overrides",
          "type": "object"
        }
      },
      "title": "PrintSettings",
      "type": "object"
    },
    "ProductForm": {
      "description": "What the printed object is, set at intake and kept by every stage (FROM JACKSON).\n\nflat: a relief charm, a height field of the front view with a flat back.\nfigure: a full 3D figure, never flattened later.",
      "enum": [
        "flat",
        "figure"
      ],
      "title": "ProductForm",
      "type": "string"
    },
    "ProductType": {
      "enum": [
        "figurine",
        "keychain",
        "nameplate",
        "ornament",
        "magnet",
        "other"
      ],
      "title": "ProductType",
      "type": "string"
    },
    "SizeTier": {
      "enum": [
        "xs",
        "s",
        "m",
        "l"
      ],
      "title": "SizeTier",
      "type": "string"
    },
    "StageId": {
      "enum": [
        "s01_intake",
        "s02_color_spec",
        "s03_concept",
        "s04_multiview",
        "s05_mesh",
        "s06_printability",
        "s07_baseline",
        "s08_palette",
        "s09_paint",
        "s10_write"
      ],
      "title": "StageId",
      "type": "string"
    },
    "TextSpec": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 24,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "font": {
          "default": "rounded-bold",
          "description": "Font key from the geometry package",
          "title": "Font",
          "type": "string"
        },
        "cap_height_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = fit to plate",
          "title": "Cap Height Mm"
        },
        "relief_mm": {
          "default": 1.0,
          "description": "Raised height (or engrave depth)",
          "title": "Relief Mm",
          "type": "number"
        },
        "style": {
          "default": "raised",
          "enum": [
            "raised",
            "engraved"
          ],
          "title": "Style",
          "type": "string"
        },
        "filament_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = highest-contrast palette filament",
          "title": "Filament Id"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "description": "UUID, same as Supabase jobs.id",
      "title": "Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "product_type": {
      "$ref": "#/$defs/ProductType",
      "default": "figurine"
    },
    "target_size_mm": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Longest dimension of the print",
      "title": "Target Size Mm"
    },
    "size_tier": {
      "anyOf": [
        {
          "$ref": "#/$defs/SizeTier"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Customer's pick; sets target_size_mm"
    },
    "form": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductForm"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set by s01: flat charm or 3D figure (keychains and magnets pick; every other product is figure). None before intake finishes"
    },
    "custom_asks": {
      "description": "Set by s01",
      "items": {
        "$ref": "#/$defs/CustomAsk"
      },
      "title": "Custom Asks",
      "type": "array"
    },
    "addons": {
      "items": {
        "$ref": "#/$defs/AddOn"
      },
      "title": "Addons",
      "type": "array"
    },
    "photos": {
      "items": {
        "$ref": "#/$defs/Photo"
      },
      "title": "Photos",
      "type": "array"
    },
    "settings": {
      "$ref": "#/$defs/PrintSettings"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "queued"
    },
    "stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/StageId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profile": {
      "default": "thin_slice",
      "enum": [
        "thin_slice",
        "full"
      ],
      "title": "Profile",
      "type": "string"
    },
    "access": {
      "default": "owner",
      "enum": [
        "owner",
        "code"
      ],
      "title": "Access",
      "type": "string"
    },
    "pause_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pause Reason"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "payloads.JobResult as a dict once s07 or s10 ships",
      "title": "Result"
    },
    "attempts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Current (accepted) attempt number per stage",
      "propertyNames": {
        "$ref": "#/$defs/StageId"
      },
      "title": "Attempts",
      "type": "object"
    }
  },
  "required": [
    "id",
    "created_at",
    "prompt"
  ],
  "title": "JobRecord",
  "type": "object"
}
