# apps/web environment. Copy to .env.local (gitignored), or run `npm run sync-env` to copy the
# server keys from the repo root .env. Never put a secret in a NEXT_PUBLIC_ variable.

# Browser (public): Jackson's Supabase login and Realtime. Publishable key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_DATA=mock    # mock data, no auth gate (development only)

# Server only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ACCESS_CODE=               # studio access code
ACCESS_COOKIE_SECRET=      # 16+ random characters; signs the access cookie and upload tickets
ORDER_NOTIFY_EMAIL=        # where new orders are emailed
AGENTMAIL_API_KEY=         # optional; without it orders are stored with notify_error = no provider
AGENTMAIL_INBOX_ID=        # sending inbox id
FIRST_LOOK_ENABLED=false   # first look on the confirmation page; keep false until Jackson approves spend
FIRST_LOOK_DAILY_CAP=5     # first looks per New York day, counted from spend rows
MESHY_API_KEY=             # only read when FIRST_LOOK_ENABLED is true (mock mode uses a fake)
MESHY_MODE=test            # spend rows are test_mode unless this is live
